APP_NAME=ORCA Marine Intelligence API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
POSTGRES_DB=orca
POSTGRES_USER=orca
# Local development only. Replace through your private .env outside development.
POSTGRES_PASSWORD=orca_local_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://orca:orca_local_dev_password@localhost:5432/orca
# Generate a unique, long random value for every non-development environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Forecast providers (Open-Meteo public endpoints require no API key)
WEATHER_PROVIDER=open_meteo
MARINE_PROVIDER=open_meteo
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
WEATHER_REQUEST_TIMEOUT=8
MARINE_REQUEST_TIMEOUT=10
PROVIDER_RETRY_COUNT=1
WEATHER_CACHE_TTL=600
MARINE_CACHE_TTL=900

# Marine safety alerts. Demo fixtures are disabled unless explicitly enabled.
ALERT_PROVIDERS=imd_cap,incois
IMD_CAP_FEED_URL=https://cap-sources.s3.amazonaws.com/in-imd-en/rss.xml
IMD_CAP_BASE_URL=https://cap-sources.s3.amazonaws.com/in-imd-en/
ALERT_REQUEST_TIMEOUT=10
ALERT_CACHE_TTL=900
ALERT_MAX_FEED_ITEMS=20
ALERT_REFRESH_INTERVAL_MINUTES=15
ORCA_DEMO_MODE=false
